{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rudironsoni/cursor-plugins-for-all-harnesses/schemas/codex-marketplace.schema.json",
  "title": "Codex Plugin Marketplace",
  "description": "Schema for .agents/plugins/marketplace.json.",
  "type": "object",
  "required": ["name", "plugins"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "interface": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "displayName": { "type": "string" }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
          },
          "source": {
            "type": "object",
            "required": ["source"],
            "additionalProperties": true,
            "properties": {
              "source": { "type": "string" },
              "path": { "type": "string" }
            }
          },
          "policy": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "installation": {
                "type": "string",
                "enum": ["AVAILABLE", "INSTALLED_BY_DEFAULT", "NOT_AVAILABLE"]
              },
              "authentication": {
                "type": "string",
                "enum": ["ON_INSTALL", "ON_FIRST_USE"]
              }
            }
          },
          "category": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
