{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rudironsoni/cursor-plugins-for-all-harnesses/schemas/grok-marketplace.schema.json",
  "title": "Grok Build Plugin Marketplace",
  "description": "Schema for .grok-plugin/marketplace.json.",
  "type": "object",
  "required": ["name", "plugins"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "owner": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string" }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
          },
          "description": { "type": "string" },
          "source": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "source": { "type": "string" },
                  "type": { "type": "string" },
                  "path": { "type": "string" },
                  "url": { "type": "string" },
                  "sha": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
